{
  "name": "forgeflow",
  "version": "1.0.0",
  "private": true,
  "description": "Generate production-ready interactive UI prototypes using AI.",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,md,json,yml,yaml}\""
  },
  "devDependencies": {
    "turbo": "^2.10.8"
  }
}
