{
  "name": "forgeflow",
  "version": "1.0.0",
  "private": true,
  "description": "Generate production-ready interactive UI prototypes using AI.",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "turbo run dev",
